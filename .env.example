# Backend / local
FRONTEND_ORIGIN=http://localhost:5173
ENABLE_SAMPLE_DATA=false

# Keyless live defaults
# TfL works anonymously at a lower quota.
TFL_APP_KEY=
# Live GB rail JSON. No API key required.
TRAINIAC_BASE_URL=https://api.traini.ac

# Optional direct National Rail / Rail Data Marketplace access.
NATIONAL_RAIL_API_KEY=
NATIONAL_RAIL_DEPARTURES_URL=

# Optional commercial live-flight providers. If neither is set, FareSphere
# uses the keyless OctoTrip real-time flight search service.
SKYSCANNER_API_KEY=
DUFFEL_ACCESS_TOKEN=

# Optional Trainline Partner Solutions.
TRAINLINE_API_BASE_URL=
TRAINLINE_API_TOKEN=
