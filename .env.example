# Frontend
VITE_API_URL=http://localhost:8000/api/v1
VITE_ENABLE_SAMPLE_DATA=false

# Backend
FRONTEND_ORIGIN=http://localhost:5173
ENABLE_SAMPLE_DATA=false

# Transport for London Unified API (optional; anonymous access works at a lower quota)
TFL_APP_KEY=

# National Rail / Rail Data Marketplace
# Subscribe to Live Departure Board and paste the Consumer key.
NATIONAL_RAIL_API_KEY=
# Optional override. FareSphere has a current Live Departure Board endpoint default.
NATIONAL_RAIL_DEPARTURES_URL=

# Live flights — configure one approved provider.
SKYSCANNER_API_KEY=
DUFFEL_ACCESS_TOKEN=

# Trainline Partner Solutions (commercial partner access; do not guess/scrape endpoints)
TRAINLINE_API_BASE_URL=
TRAINLINE_API_TOKEN=
