# Frontend
VITE_API_URL=http://localhost:8000/api/v1
VITE_ENABLE_SAMPLE_DATA=false

# Backend
FRONTEND_ORIGIN=http://localhost:5173
ENABLE_SAMPLE_DATA=false

# Transport for London Unified API
# Register at https://api-portal.tfl.gov.uk/ and create a key.
TFL_APP_KEY=

# National Rail / Rail Data Marketplace
# Subscribe to the Live Departure Board product and copy the Consumer key.
NATIONAL_RAIL_API_KEY=
# Paste the exact endpoint shown in your RDM subscription; include {crs} in the path.
# Example shape only (your product path may differ):
# NATIONAL_RAIL_DEPARTURES_URL=https://api1.raildata.org.uk/<product>/LDBWS/api/20220120/GetDepBoardWithDetails/{crs}
NATIONAL_RAIL_DEPARTURES_URL=

# Live flights via Duffel
DUFFEL_ACCESS_TOKEN=

# Trainline Partner Solutions (commercial partner access; do not guess/scrape endpoints)
TRAINLINE_API_BASE_URL=
TRAINLINE_API_TOKEN=
